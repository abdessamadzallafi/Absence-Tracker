// Prisma Schema for Absence Tracker API
// Database: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Professeur (pour l'authentification)
model Professor {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // hashed with bcrypt
  firstName String
  lastName  String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professors")
}

// Groupe/Classe
model Group {
  id        Int       @id @default(autoincrement())
  name      String
  filiere   String
  students  Student[]
  modules   Module[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("groups")
}

// Étudiant
model Student {
  id          Int          @id @default(autoincrement())
  groupId     Int
  group       Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  massar      String       @unique
  firstName   String
  lastName    String
  email       String?
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([groupId])
  @@map("students")
}

// Module (cours)
model Module {
  id        Int       @id @default(autoincrement())
  name      String
  semester  String
  groupId   Int
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([groupId])
  @@map("modules")
}

// Session (séance de cours)
model Session {
  id          Int          @id @default(autoincrement())
  moduleId    Int
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  date        DateTime
  time        String
  type        String       // cours, td, tp
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([moduleId])
  @@map("sessions")
}

// Présence
model Attendance {
  id        Int      @id @default(autoincrement())
  sessionId Int
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String   // present, absent, justified
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@map("attendances")
}
